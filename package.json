{
  "name": "claude-code-monitor",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "yarn@4.6.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "yarn workspaces foreach -Ap run dev",
    "dev:api": "yarn workspace @claude-code-monitor/api dev",
    "dev:web": "yarn workspace @claude-code-monitor/web dev",
    "build": "yarn workspaces foreach -Apt run build",
    "lint": "yarn workspaces foreach -Ap run lint",
    "test": "yarn workspaces foreach -Ap run test"
  }
}
